direction: right

FR: {
  label: "FreeRTOS"
  FP: "固定优先级"
  TS: "TIME_SLICING 开: 同级 RR"
  NT: "关: 同级不轮转"
}
LX: {
  label: "Linux"
  CFS: "CFS + nice / vruntime"
  RR: "SCHED_RR ≈ 同级时间片"
  FIFO: "SCHED_FIFO ≈ 同级不轮转"
}

TS_-_最像_-__RR: "TS -.最像.-> RR"
NT_-_接近_-__FIFO: "NT -.接近.-> FIFO"
FP_-_不是_-__CFS: "FP -.不是.-> CFS"

FR.FP -> FR.TS
FR.FP -> FR.NT
